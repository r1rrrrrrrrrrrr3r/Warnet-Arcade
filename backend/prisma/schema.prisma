generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

model Game {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String
  devComment  String   @default("")
  howToPlay   String
  coverImage  String
  engine      String
  genre       String   @default("Arcade")
  entryFile   String
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}